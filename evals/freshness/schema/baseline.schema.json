{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "fixtures_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "contract_only"
    },
    "fixtures_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pavan2184/tencent-hack/main/evals/freshness/schema/baseline.schema.json"
}
