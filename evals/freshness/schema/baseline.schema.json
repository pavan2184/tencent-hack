{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "status", "fixtures_hash", "config", "thresholds", "counts"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline_id": { "const": "main" },
    "status": {
      "const": "contract_only"
    },
    "fixtures_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "network", "llm", "providers", "suites"],
      "properties": {
        "clock": { "const": "logical" },
        "network": { "const": "disabled" },
        "llm": { "const": "disabled" },
        "providers": {
          "type": "array",
          "prefixItems": [{ "const": "confluence" }, { "const": "slack" }, { "const": "jira" }, { "const": "google-drive" }],
          "items": false,
          "minItems": 4
        },
        "suites": {
          "type": "array",
          "prefixItems": [
            { "const": "fast-path" }, { "const": "delta-recovery" }, { "const": "reconciliation" },
            { "const": "critical-verification" }, { "const": "receipt-integrity" },
            { "const": "failure-recovery" }, { "const": "cross-platform-contract" }
          ],
          "items": false,
          "minItems": 7
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale_critical_exposures", "accepted_event_loss", "cursor_advanced_past_unaccounted_work",
        "duplicate_mutations", "tombstone_accuracy", "receipt_field_accuracy", "safe_fallback_rate",
        "eventual_convergence_rate", "webhook_max_propagation_seconds", "delta_max_recovery_seconds",
        "reconciliation_max_convergence_seconds"
      ],
      "properties": {
        "stale_critical_exposures": { "const": 0 },
        "accepted_event_loss": { "const": 0 },
        "cursor_advanced_past_unaccounted_work": { "const": 0 },
        "duplicate_mutations": { "const": 0 },
        "tombstone_accuracy": { "const": 1 },
        "receipt_field_accuracy": { "const": 1 },
        "safe_fallback_rate": { "const": 1 },
        "eventual_convergence_rate": { "const": 1 },
        "webhook_max_propagation_seconds": { "const": 60 },
        "delta_max_recovery_seconds": { "const": 300 },
        "reconciliation_max_convergence_seconds": { "const": 3600 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtures", "gate", "holdout", "providers", "suites"],
      "properties": {
        "fixtures": { "const": 12 },
        "gate": { "const": 10 },
        "holdout": { "const": 2 },
        "providers": { "const": 4 },
        "suites": { "const": 7 }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pavan2184/tencent-hack/main/evals/freshness/schema/baseline.schema.json"
}
