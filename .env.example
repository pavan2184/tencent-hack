# Copy to .env. Every value here is mock-safe: the whole stack boots and tests with no secrets.

# --- Runtime ---
ENV=development                  # development | production (production fails fast on blank core settings)
ROLE=api                         # api | worker | beat | migrate | seed (set per container by compose)
PROVIDER_MODE=mock               # mock | real (real requires the selected provider's credentials)
LOG_LEVEL=info

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# --- Database / Redis / Celery ---
DATABASE_URL=postgresql+psycopg://brain:brain@postgres:5432/brain
DB_POOL_SIZE=5
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false   # true runs Celery tasks inline (no worker needed)

# --- Identity (demo personas, no auth; see docs/SECURITY_REVIEW.md) ---
ACTOR_HEADER=X-Actor-Id

# --- Models / providers (mock by default; Tencent ADP values TBD — confirm in the ADP console) ---
LLM_PROVIDER=openai_compatible   # openai_compatible | tencent_adp_app
LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v3
LLM_TIMEOUT_S=30
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024               # ADP custom vector models are 1024-dim; changing this requires `make reset`
TENCENT_ADP_APP_KEY=
TENCENT_ADP_CHAT_URL=https://wss.lke.tencentcloud.com/adp/v2/chat

# --- Governed pipeline ---
ASK_TOP_K=8
ASK_OVERFETCH_FACTOR=4
ASK_MAX_CONTEXT_CHARS=12000
GROUNDING_MIN_COVERAGE=0.6
FRESHNESS_LIVE_VERIFY_CRITICAL=true
DEFAULT_POLICY_ID=default

# --- Upload & budget caps (PLACEHOLDERS — final numbers TBD by Raphael; keeps the Tencent free trial safe) ---
UPLOAD_DIR=/data/uploads
UPLOAD_ALLOWED_EXTENSIONS=md,txt
UPLOAD_MAX_FILE_BYTES=1000000
UPLOAD_MAX_FILES_TOTAL=200
UPLOAD_MAX_FILES_PER_ACTOR_PER_DAY=20
EMBEDDING_DAILY_CALL_BUDGET=2000

# --- Sync / workers ---
SYNC_DELTA_INTERVAL_S=60
SYNC_RECONCILE_INTERVAL_S=600
WATCHDOG_INTERVAL_S=60
TASK_MAX_RETRIES=3

# --- Seed / migrations ---
SEED_DIR=/app/seed
MIGRATIONS_DIR=                  # empty = auto-resolve infra/postgres/migrations; compose mounts it at /app/migrations

# --- Frontend (baked in at build time; compose passes them as build args) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_MCP_URL=http://localhost:8000/mcp
NEXT_PUBLIC_DEFAULT_ACTOR_ID=alex.tan
